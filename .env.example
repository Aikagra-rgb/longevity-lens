# LongevityLens — Environment Variables Example
# Copy this file to .env and fill in your values

# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ARES Level-2 Runtime Security Gateway
ARES_GATEWAY_URL=
ARES_API_KEY=
ARES_ORG_ID=org_longevity_lens
ARES_APP_NAME=LongevityLensCopilot
ARES_CANARY_TOKEN=CANARY_LONGEVITY_LENS_01
ARES_OPTIMIZE_PROMPTS=false
ARES_FAIL_CLOSED=false
